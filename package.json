{
  "name": "burst-board",
  "productName": "Burst Board",
  "version": "1.0.0",
  "description": "Turn ideas into one-burst ships. Local-only, offline macOS desktop app.",
  "author": "Ramoji",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build": "rimraf dist dist-electron && npm run build:electron && npm run build:renderer",
    "icon": "node scripts/make-icon.mjs",
    "start": "npm run build && electron .",
    "dist:mac": "npm run icon && npm run build && electron-builder --mac --arm64",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "npm run build && electron tests/electron-smoke.cjs",
    "test:ui": "npm run build && electron tests/electron-ui.cjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:electron && npm run test:ui",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.burstboard.desktop",
    "productName": "Burst Board",
    "copyright": "Burst Board",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icon",
      "darkModeSupport": true,
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": false,
        "NSUserNotificationAlertStyle": "alert"
      }
    },
    "dmg": {
      "title": "Burst Board",
      "artifactName": "Burst-Board-${version}-arm64.dmg",
      "icon": "build/icon.icns"
    },
    "afterPack": "scripts/after-pack.cjs"
  },
  "license": "Apache-2.0"
}
